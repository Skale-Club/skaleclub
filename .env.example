# Database Configuration
# Main connection string (required)
POSTGRES_URL=postgresql://user:password@host:port/database

# Session Configuration
# Secret key for session encryption - create a random string
SESSION_SECRET=your-secure-random-session-secret-here

# Admin Account
# Initial admin credentials
ADMIN_EMAIL=admin@example.com

# Supabase Configuration
# Required for Auth and Storage
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Security (used by keep-alive endpoint)
CRON_SECRET=your-cron-secret
# Xphere lead handoff: the API key is configured in Admin -> Integrations -> CRM -> Xphere
# (stored in the xphere_settings table, no env var). When DISABLE_INPROCESS_CRON=true,
# schedule POST /api/integrations/xphere/sweep with "Authorization: Bearer $CRON_SECRET"
# every 5 minutes from an external scheduler.

# Optional AI Provider Keys (you can also set keys in Admin -> Integrations)
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Presentation slide authoring uses Gemini (configured in Admin → Integrations).
# No ANTHROPIC_API_KEY is required anywhere in this project.

# AbortController timeout (milliseconds) for every blog Gemini call.
# Empty/zero/non-numeric values fall back to 30000 (30 seconds).
BLOG_GEMINI_TIMEOUT_MS=30000

# Cloudflare Turnstile (CAPTCHA on email/password login + signup forms)
# Site key is public (served to the client via /api/supabase-config).
# Secret key is pasted into Supabase Dashboard → Authentication → Bot and Abuse Protection.
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA-replace-me
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAA-replace-me

# Sentry Error Monitoring
# Create projects at sentry.io (org: skale-club) and paste the DSNs below.
SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXXXX
VITE_SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXXXX
# Auth token for uploading source maps during build (Settings → API Keys in Sentry)
SENTRY_AUTH_TOKEN=

# Build Configuration
NODE_ENV=development

# Reverse-proxy hops in front of the app (Traefik = 1). Set 2 behind Cloudflare
# so req.ip, rate limits and Turnstile see the visitor, not the edge.
TRUST_PROXY_HOPS=1

# Postgres TLS. Default accepts any certificate; set to true (and point
# PG_SSL_CA at the Supabase CA bundle if needed) to fail closed on a bad chain.
PG_SSL_REJECT_UNAUTHORIZED=false
# PG_SSL_CA=/etc/ssl/certs/supabase-ca.crt

# Self-applying maintenance tasks (content fixes, product artwork, 3D Printing
# card) run a few seconds after every boot; set to true to keep them off.
DISABLE_BOOTSTRAP_TASKS=false
# Model used to generate service card images (Gemini key from GEMINI_API_KEY
# or the admin's Gemini integration).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
