# Database Configuration
# Main connection string (required)
POSTGRES_URL=postgresql://user:password@host:port/database

# Session Configuration
# Secret key for session encryption - create a random string
SESSION_SECRET=your-secure-random-session-secret-here

# Admin Account
# Initial admin credentials
ADMIN_EMAIL=admin@example.com

# Supabase Configuration
# Required for Auth and Storage
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Security (used by keep-alive endpoint)
CRON_SECRET=your-cron-secret
# Xphere lead handoff: the API key is configured in Admin -> Integrations -> CRM -> Xphere
# (stored in the xphere_settings table, no env var). While ENABLE_INPROCESS_CRON is not
# "true", schedule POST /api/integrations/xphere/sweep with "Authorization: Bearer $CRON_SECRET"
# every 5 minutes from an external scheduler.

# Optional AI Provider Keys (you can also set keys in Admin -> Integrations)
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Presentation slide authoring uses Gemini (configured in Admin → Integrations).
# No ANTHROPIC_API_KEY is required anywhere in this project.

# AbortController timeout (milliseconds) for every blog Gemini call.
# Empty/zero/non-numeric values fall back to 30000 (30 seconds).
# (Legacy name; BLOG_AI_TIMEOUT_MS below takes precedence.)
BLOG_GEMINI_TIMEOUT_MS=30000

# Cloudflare Turnstile (CAPTCHA on email/password login + signup forms)
# Site key is public (served to the client via /api/supabase-config).
# Secret key is pasted into Supabase Dashboard → Authentication → Bot and Abuse Protection.
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA-replace-me
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAA-replace-me

# Sentry Error Monitoring
# Create projects at sentry.io (org: skale-club) and paste the DSNs below.
SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXXXX
VITE_SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXXXX
# Auth token for uploading source maps during build (Settings → API Keys in Sentry)
SENTRY_AUTH_TOKEN=

# Build Configuration
NODE_ENV=development

# Reverse-proxy hops in front of the app (Traefik = 1). Set 2 behind Cloudflare
# so req.ip, rate limits and Turnstile see the visitor, not the edge.
TRUST_PROXY_HOPS=1

# Postgres TLS. PG_SSL_REJECT_UNAUTHORIZED=false accepts any certificate; set it to
# true to fail closed on a bad chain. PG_SSL_CA is the path to the CA bundle to trust.
PG_SSL_REJECT_UNAUTHORIZED=false
# PG_SSL_CA=/etc/ssl/certs/supabase-ca.crt

# In-process crons (blog generator, RSS fetch, Xphere sweep). OFF by default so a
# dev server on the production database never starts them. Set to true only on
# the one host that owns scheduling. DISABLE_INPROCESS_CRON=true still forces off.
ENABLE_INPROCESS_CRON=false

# Self-applying maintenance tasks (content fixes, product artwork, 3D Printing
# card) run a few seconds after boot. Default: ON when NODE_ENV=production, OFF in
# development; set to true to run them in dev. DISABLE_BOOTSTRAP_TASKS=true forces off.
ENABLE_BOOTSTRAP_TASKS=false

# Port the HTTP server listens on (default 1000; the container sets 8888).
# Development binds 127.0.0.1, production binds 0.0.0.0.
PORT=1000

# Public origin of the site, used to build absolute links (Telegram approval
# webhooks, blog links, OpenRouter referer). SITE_URL wins over APP_URL.
APP_URL=http://localhost:1000
SITE_URL=http://localhost:1000

# Apex host for the www -> apex redirect (production: skale.club). Empty = no redirect.
CANONICAL_HOST=

# Key that encrypts stored integration tokens (Telegram, etc.). 32+ random bytes,
# base64 or hex. Changing it makes previously stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Comma-separated hosts an MCP OAuth client may redirect to, on top of the built-in list.
MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=

# Per-attempt timeout (ms) for blog AI calls. Supersedes BLOG_GEMINI_TIMEOUT_MS.
BLOG_AI_TIMEOUT_MS=30000

# Emergency deploy-time override for the Gemini model that authors presentations.
# GEMINI_PRESENTATION_MODEL=

# Daily cap on AI translation calls made by /api/translate (0/empty = the code default).
# TRANSLATE_DAILY_CAP=

# Only for scripts/db-push-guard.mjs: allows `npm run db:push` against a Supabase URL.
# ALLOW_DB_PUSH=1
# Model used to generate service card images (Gemini key from GEMINI_API_KEY
# or the admin's Gemini integration).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
