{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--max-http-header-size=65536 tsx --import ./server/instrument.ts server/index.ts",
    "build": "tsx script/build.ts",
    "start": "cross-env NODE_ENV=production node --require ./dist/instrument.cjs dist/index.cjs",
    "check": "tsc",
    "db:push": "node scripts/db-push-guard.mjs",
    "seed": "tsx scripts/seed.ts",
    "gen:service-images": "tsx scripts/generate-service-images.ts",
    "secrets:scan": "tsx scripts/run-gitleaks.ts",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "test": "cross-env DATABASE_URL=postgresql://test:test@127.0.0.1:1/test POSTGRES_URL=postgresql://test:test@127.0.0.1:1/test tsx --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@sentry/node": "^10.62.0",
