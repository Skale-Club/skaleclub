    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.19.0",
    "fflate": "^0.8.3",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.30.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "twilio": "^5.11.2",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
